# Copy this to .env.local for local development. In Netlify these go in
# Site configuration -> Environment variables instead -- see README.md.

# Supabase project settings, from Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# The vault's own deployed URL, used to build magic-link redirect URLs.
# e.g. https://klehomerie-vault.netlify.app
NEXT_PUBLIC_SITE_URL=

# Comma-separated list of operator email addresses allowed into /admin.
OPERATOR_EMAILS=

# Base64-encoded Google service account key JSON (the whole file, base64
# encoded as one line). See README.md for how to create and encode it.
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# The Klehomerie CRM Google Sheet's ID (from its URL, not its name).
CRM_GOOGLE_SHEET_ID=

# From https://console.anthropic.com/settings/keys. Powers the AI document
# brief generated after each upload.
ANTHROPIC_API_KEY=

# ClickUp Personal API Token (ClickUp -> Settings -> Apps -> API Token).
# Posts a task to the "Vault - Authorizations" list on every client
# approve/decline decision.
CLICKUP_API_TOKEN=

# Set already -- the ClickUp list the app posts authorization tasks into.
# Not a secret, just recorded here for completeness.
CLICKUP_AUTHORIZATIONS_LIST_ID=901220637274

# Set already -- shared secret the authorizations_notify_clickup Postgres
# trigger sends so the webhook route can reject unrelated callers.
WEBHOOK_SHARED_SECRET=
