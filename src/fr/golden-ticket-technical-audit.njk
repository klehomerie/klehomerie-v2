                <tbody>
                    <tr>
                        <td><strong>LOT 00</strong></td>
                        <td data-lang-key="gtLot00Class">Environnement général</td>
                        <td data-lang-key="gtLot00Desc">Type de rue et nuisances sonores, accès à l'immeuble, interphone, boîtes aux lettres, cage d'escalier, état de service de l'ascenseur, colonne gaz</td>
                    </tr>
