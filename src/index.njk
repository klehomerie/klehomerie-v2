<script>
    // ==========================================
    // 1. STACKED CAROUSEL MANAGEMENT (3D DECK)
    // ==========================================
    const deck = document.getElementById('testimonial-deck');
    const deckCards = Array.from(document.querySelectorAll('.testimonial-card'));
    let activeDeckIndex = 0;
    let deckInterval;
    let deckHovered = false;

    function renderDeckState() {
        if (deckCards.length === 0) return;

        deckCards.forEach((card, i) => {
            let offset = i - activeDeckIndex;
            
            if (offset < -1) offset += deckCards.length;
            if (offset > 1) offset -= deckCards.length;

            if (offset === 0) {
                // ACTIVE MIDDLE CARD
                card.style.transform = "translateX(0) scale(1)";
                card.style.opacity = "1";
                card.style.zIndex = "30";
                card.style.pointerEvents = "auto";
                card.classList.add('shadow-2xl');
            } else if (offset === 1 || (offset === -(deckCards.length - 1) && deckCards.length > 2)) {
                // RIGHT BACKGROUND CARD
                card.style.transform = window.innerWidth < 768 ? "translateX(20px) scale(0.9)" : "translateX(200px) scale(0.9)";
                card.style.opacity = "0.35";
                card.style.zIndex = "20";
                card.style.pointerEvents = "auto";
                card.classList.remove('shadow-2xl');
            } else if (offset === -1 || (offset === (deckCards.length - 1) && deckCards.length > 2)) {
                // LEFT BACKGROUND CARD
                card.style.transform = window.innerWidth < 768 ? "translateX(-20px) scale(0.9)" : "translateX(-200px) scale(0.9)";
                card.style.opacity = "0.35";
                card.style.zIndex = "20";
                card.style.pointerEvents = "auto";
                card.classList.remove('shadow-2xl');
            } else {
                // HIDDEN TRACK CARDS
                card.style.transform = "translateX(0) scale(0.8)";
                card.style.opacity = "0";
                card.style.zIndex = "10";
                card.style.pointerEvents = "none";
                card.classList.remove('shadow-2xl');
            }
        });
    }

    function nextDeckCard() {
        if (!deckHovered) {
            activeDeckIndex = (activeDeckIndex + 1) % deckCards.length;
            renderDeckState();
        }
    }

    deckCards.forEach((card, idx) => {
        card.addEventListener('click', () => {
            if (idx !== activeDeckIndex) {
                activeDeckIndex = idx;
                renderDeckState();
            }
        });
    });

    deckInterval = setInterval(nextDeckCard, 5000);

    if (deck) {
        deck.addEventListener('mouseenter', () => deckHovered = true);
        deck.addEventListener('mouseleave', () => deckHovered = false);
        deck.addEventListener('touchstart', () => deckHovered = true);
        deck.addEventListener('touchend', () => {
            setTimeout(() => deckHovered = false, 3000);
        });
    }

    window.addEventListener('resize', renderDeckState);
    window.addEventListener('load', renderDeckState);
    setTimeout(renderDeckState, 150);

    // ==========================================
    // 2. LANGUAGE TOGGLE INTEGRATION HOOK
    // ==========================================
    document.addEventListener('click', function(e) {
        const langBtn = e.target.closest('.lang-btn');
        if (langBtn) {
            const targetLang = langBtn.getAttribute('data-lang'); 
            
            document.querySelectorAll('.lang-en, .lang-fr, .lang-el').forEach(quote => {
                quote.style.display = 'none';
            });

            document.querySelectorAll('.lang-' + targetLang).forEach(quote => {
                quote.style.display = 'block';
            });
            
            renderDeckState();
        }
    });
</script>

