<script>
function calculateRisk() {
    const form = document.getElementById('riskForm');
    const formData = new FormData(form);
    let score = 0;
    let answered = 0;
    // Sum up the weighted values (0, 10, 15, 20)
    for (let pair of formData.entries()) {
        score += parseInt(pair[1]);
        answered++;
    }

    if (answered < 5) {
        alert("Please answer all 5 questions.");
        return;
    }

    // Elements
    const quizContainer = document.getElementById('quiz-questions');
    const resultContainer = document.getElementById('quiz-result');
    const title = document.getElementById('result-title');
    const desc = document.getElementById('result-desc');
    const icon = document.getElementById('result-icon');
    const scoreDisplay = document.getElementById('score-text-display');
    const hiddenInput = document.getElementById('hidden-risk-score');
    
    // Switch View
    quizContainer.classList.add('hidden');
    resultContainer.classList.remove('hidden');

    // LOGIC: Max Score is around 85.
    // Low: 0-20 | Med: 21-50 | High: 51+
    
    if (score >= 50) {
        // HIGH RISK
        icon.innerText = "🚨";
        title.innerText = "Critical Risk Detected";
        scoreDisplay.innerText = "Risk Score: " + score + " / 85";
        desc.innerText = "Your asset is showing significant technical liabilities. Proceed with extreme caution.";
        hiddenInput.value = "High Risk (" + score + ")";
    } else if (score >= 20) {
        // MEDIUM RISK
        icon.innerText = "⚠️";
        title.innerText = "Moderate Caution Required";
        scoreDisplay.innerText = "Risk Score: " + score + " / 85";
        desc.innerText = "There are red flags. Before you sign, you need to verify if these are cosmetic or structural.";
        hiddenInput.value = "Medium Risk (" + score + ")";
    } else {
        // LOW RISK
        icon.innerText = "✅";
        title.innerText = "Preliminary Pass";
        scoreDisplay.innerText = "Risk Score: " + score + " / 85";
        desc.innerText = "The basics look solid. However, fresh paint can hide many sins. Use the full checklist to be sure.";
        hiddenInput.value = "Low Risk (" + score + ")";
    }
}

function resetQuiz() {
    document.getElementById('riskForm').reset();
    document.getElementById('quiz-result').classList.add('hidden');
    document.getElementById('quiz-questions').classList.remove('hidden');
}
</script>

