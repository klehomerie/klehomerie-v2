<body class="antialiased">
{# Resolves an English nav path to its real /fr/ equivalent when the current
   page is French and one exists (reusing the hreflang pairs from <head>);
   otherwise returns the path unchanged. Keeps in-site nav/footer links from
   bouncing a French visitor back into the English page tree. #}
{% macro frHref(enPath) -%}
    {%- if locale == 'fr' and enPath in frRealElQueryEnUrls -%}
        {{- frRealElQueryFrUrls[frRealElQueryEnUrls.indexOf(enPath)] -}}
    {%- elif locale == 'fr' and enPath in frOnlyPairEnUrls -%}
        {{- frOnlyPairFrUrls[frOnlyPairEnUrls.indexOf(enPath)] -}}
    {%- else -%}
        {{- enPath -}}
    {%- endif -%}
{%- endmacro %}

