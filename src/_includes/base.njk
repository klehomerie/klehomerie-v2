<!DOCTYPE html>
<html lang="{{ locale or 'en-Us' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    {% set siteUrl = "https://klehomerie.com" %}
    {# 1. Check if we have a custom image, otherwise use default #}
    {% set originalImage = image or "/assets/images/hero-athens-view.webp" %}

    <title>{{ title or "Property Audits & Asset Management Athens | Klehomerie" }}</title>
    <meta name="title" content="{{ title or "Property Audits & Asset Management Athens | Klehomerie" }}">
    
    <meta name="description" content="{{ summary or description or "Independent technical audits and asset management for Athens real estate investors. Protect your capital with professional structural scans." }}">

    <meta name="author" content="Arnaud Zerdab - Klehomerie">
    <meta name="format-detection" content="telephone=no">

    <link rel="canonical" href="https://klehomerie.com{{ page.url }}">
    
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://klehomerie.com{{ page.url }}">
    <meta property="og:title" content="{{ title or 'Klehomerie | Asset Management' }}">
    <meta property="og:description" content="{{ summary or description or 'Technical property audits and asset management in Athens.' }}">
    <meta property="og:image" content="{{ siteUrl }}{{ originalImage | socialImg }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="Klehomerie">
    <meta property="og:locale" content="{% if locale == 'fr' %}fr_FR{% elif locale == 'el' %}el_GR{% else %}en_US{% endif %}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="{{ siteUrl }}{{ page.url }}">
    <meta name="twitter:site" content="@klehomerie">
    <meta name="twitter:creator" content="@klehomerie">
    <meta name="twitter:title" content="{{ title or "Property Audits & Asset Management Athens | Klehomerie" }}">
    <meta name="twitter:description" content="{{ summary or description or "Protect your real estate capital in Athens. Klehomerie provides independent technical audits, thermal imaging red flag scans, and long-term asset management for international investors." }}">
    <meta name="twitter:image" content="{{ siteUrl }}{{ originalImage | socialImg }}">

    {# hreflang alternates: only declared where the target URL actually carries
       equivalent translated content, per Google's hreflang guidelines.
       - "/", "/methodology/", "/legal/privacy/", "/legal/terms/",
         "/testimonials/", "/golden-ticket-technical-audit/" now have real
         French URLs under /fr/ (Phase 5), plus a query-param Greek
         alternate on the English URL, since Greek stays on the client-side
         mechanism for now (see the Phase 5 plan for why).
       - "/checklist/", "/scope/" (and checklist's two sub-pages) are real,
         separate EN/FR pages with no EL equivalent at all: checklist never
         had one, and scope's FR copy was supplied without a Greek version.
       - Everything else (media, klab, thank-you) has no translated body
         copy yet, so it only self-references. #}
    {% set frRealElQueryEnUrls = ["/", "/methodology/", "/legal/privacy/", "/legal/terms/", "/testimonials/", "/golden-ticket-technical-audit/"] %}
    {% set frRealElQueryFrUrls = ["/fr/", "/fr/methodology/", "/fr/legal/privacy/", "/fr/legal/terms/", "/fr/testimonials/", "/fr/golden-ticket-technical-audit/"] %}
    {% set frOnlyPairEnUrls = ["/checklist/", "/checklist/check-your-inbox/", "/checklist/confirmed/", "/scope/"] %}
    {% set frOnlyPairFrUrls = ["/fr/checklist/", "/fr/checklist/check-your-inbox/", "/fr/checklist/confirmed/", "/fr/scope/"] %}
    {% if page.url in frRealElQueryEnUrls %}
    {% set pairIndex = frRealElQueryEnUrls.indexOf(page.url) %}
    <link rel="alternate" hreflang="en" href="https://klehomerie.com{{ page.url }}" />
    <link rel="alternate" hreflang="fr" href="https://klehomerie.com{{ frRealElQueryFrUrls[pairIndex] }}" />
    <link rel="alternate" hreflang="el" href="https://klehomerie.com{{ page.url }}?lang=el" />
    <link rel="alternate" hreflang="x-default" href="https://klehomerie.com{{ page.url }}" />
    {% elif page.url in frRealElQueryFrUrls %}
    {% set pairIndex = frRealElQueryFrUrls.indexOf(page.url) %}
    <link rel="alternate" hreflang="en" href="https://klehomerie.com{{ frRealElQueryEnUrls[pairIndex] }}" />
    <link rel="alternate" hreflang="fr" href="https://klehomerie.com{{ page.url }}" />
    <link rel="alternate" hreflang="el" href="https://klehomerie.com{{ frRealElQueryEnUrls[pairIndex] }}?lang=el" />
    <link rel="alternate" hreflang="x-default" href="https://klehomerie.com{{ frRealElQueryEnUrls[pairIndex] }}" />
    {% elif page.url in frOnlyPairEnUrls %}
    {% set pairIndex = frOnlyPairEnUrls.indexOf(page.url) %}
    <link rel="alternate" hreflang="en" href="https://klehomerie.com{{ page.url }}" />
    <link rel="alternate" hreflang="fr" href="https://klehomerie.com{{ frOnlyPairFrUrls[pairIndex] }}" />
    <link rel="alternate" hreflang="x-default" href="https://klehomerie.com{{ page.url }}" />
    {% elif page.url in frOnlyPairFrUrls %}
    {% set pairIndex = frOnlyPairFrUrls.indexOf(page.url) %}
    <link rel="alternate" hreflang="en" href="https://klehomerie.com{{ frOnlyPairEnUrls[pairIndex] }}" />
    <link rel="alternate" hreflang="fr" href="https://klehomerie.com{{ page.url }}" />
    <link rel="alternate" hreflang="x-default" href="https://klehomerie.com{{ frOnlyPairEnUrls[pairIndex] }}" />
    {% else %}
    <link rel="alternate" hreflang="en" href="https://klehomerie.com{{ page.url }}" />
    <link rel="alternate" hreflang="x-default" href="https://klehomerie.com{{ page.url }}" />
    {% endif %}

    {# Real-URL language map for the nav language switcher (script.js): when the
       current page has a dedicated /fr/ (and/or query-param /el) equivalent, the
       switcher should navigate there instead of just swapping strings via
       content.js. Built from the same pairs used for hreflang above, so a page
       only gets an entry for a language it actually has. #}
    {% set langAlt = {} %}
    {% if page.url in frRealElQueryEnUrls %}
      {% set pairIndex = frRealElQueryEnUrls.indexOf(page.url) %}
      {% set langAlt = { en: page.url, fr: frRealElQueryFrUrls[pairIndex], el: page.url + "?lang=el" } %}
    {% elif page.url in frRealElQueryFrUrls %}
      {% set pairIndex = frRealElQueryFrUrls.indexOf(page.url) %}
      {% set langAlt = { en: frRealElQueryEnUrls[pairIndex], fr: page.url, el: frRealElQueryEnUrls[pairIndex] + "?lang=el" } %}
    {% elif page.url in frOnlyPairEnUrls %}
      {% set pairIndex = frOnlyPairEnUrls.indexOf(page.url) %}
      {% set langAlt = { en: page.url, fr: frOnlyPairFrUrls[pairIndex] } %}
    {% elif page.url in frOnlyPairFrUrls %}
      {% set pairIndex = frOnlyPairFrUrls.indexOf(page.url) %}
      {% set langAlt = { en: frOnlyPairEnUrls[pairIndex], fr: page.url } %}
    {% endif %}
    <script>window.__langAlt = {{ langAlt | dump | safe }};</script>

