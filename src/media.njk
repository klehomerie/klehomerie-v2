---
layout: base.njk
title: Press Coverage | Klehomerie
description: Technical rigor in the spotlight. Selected niche commentary on Athens real estate investment protection.
---

<main class="bg-[--bg-color] pt-24 pb-20">
 <!-- Hero Section -->
    <section class="relative w-full py-10 lg:py-16 mb-8 flex items-center bg-[--bg-color] overflow-hidden">
        <div class="absolute inset-y-0 right-0 w-full md:w-3/4 h-full z-0">
            
            <img src="/assets/images/hero_media.png" 
                 alt="Klehomerie Technical Audit Blueprint" 
                 class="object-cover object-left md:object-center w-full h-full opacity-40 dark:opacity-90 transition-opacity duration-300">
            
            <div class="absolute inset-0 bg-gradient-to-r from-[--bg-color] via-[--bg-color]/80 to-transparent"></div>
            
            <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[--bg-color] to-transparent"></div>
        </div>

        <div class="relative z-10 container mx-auto px-6 max-w-6xl mt-4">
            <div class="max-w-2xl">
                <p class="text-[--accent-color] font-bold tracking-widest uppercase text-xs md:text-sm mb-3" data-lang-key="mediaSubHeader">Extreme Curated Depth Over Breadth</p>
                
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[--title-color] mb-4 uppercase tracking-tight leading-tight" data-lang-key="mediaTitle">Curated Press Dossier</h1>
                
                <p class="text-base md:text-lg text-[--text-color] uppercase tracking-wide mb-6 leading-relaxed font-medium" data-lang-key="mediaDesc">Technical rigor in the spotlight: Shifting the standard for foreign investment in Athens</p>
                
                <blockquote class="italic text-base md:text-lg text-gray-700 dark:text-gray-400 border-l-4 border-[--accent-color] pl-4 py-1">
                    "Distance is the single biggest risk to your investment. We mitigate that risk."
                </blockquote>
            </div>
        </div>
    </section>

  <!-- Media Grid Section -->
    <section class="container mx-auto px-6 max-w-6xl">
        <div class="flex items-center gap-4 mb-10">
            <!-- Dividers that adapt to theme -->
            <div class="h-px bg-gray-300 dark:bg-gray-700 flex-grow"></div>
            <!-- Section title using theme variable -->
            <h2 class="text-xl font-bold text-[--title-color] tracking-widest uppercase" data-lang-key="mediaGridTitle">Selected Niche Commentary</h2>
            <div class="h-px bg-gray-300 dark:bg-gray-700 flex-grow"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {% for article in collections.media | reverse %}
            <!-- Card wrapper using theme background and adapting borders -->
            <article class="bg-[--card-bg] border border-gray-200 dark:border-gray-800 rounded-xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 group flex flex-col">
                
                <!-- Publisher Logo Box -->
                <div class="flex items-center justify-center bg-gray-100 dark:bg-gray-900 rounded-lg p-6 mb-6 h-32 border border-gray-200 dark:border-gray-800 group-hover:border-[--accent-color] transition-colors">
                     <div class="w-full h-full" 
                          style="background-color: var(--accent-color); 
                                 -webkit-mask-image: url('{{ article.data.logoUrl }}'); 
                                 -webkit-mask-size: contain; 
                                 -webkit-mask-repeat: no-repeat; 
                                 -webkit-mask-position: center; 
                                 mask-image: url('{{ article.data.logoUrl }}'); 
                                 mask-size: contain; 
                                 mask-repeat: no-repeat; 
                                 mask-position: center;">
                     </div>
                </div>

                <!-- Optional Thumbnail -->
                {% if article.data.thumbnailUrl %}
                <div class="w-full h-48 mb-6 overflow-hidden rounded-lg">
                    <img src="{{ article.data.thumbnailUrl }}" alt="Thumbnail for {{ article.data.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                </div>
                {% endif %}

                <!-- Meta Data -->
                <div class="flex justify-between items-center mb-3">
                    <span class="text-xs text-[--accent-color] font-bold uppercase tracking-widest">{{ article.data.publisher }}</span>
                    <span class="text-xs text-gray-500">{{ article.data.date }}</span>
                </div>

                <!-- Content using theme variables -->
                <h3 class="text-xl font-bold text-[--title-color] mb-3 leading-tight">{{ article.data.title }}</h3>
                <p class="text-[--text-color] text-sm mb-8 flex-grow leading-relaxed">{{ article.data.excerpt }}</p>

                <!-- Action Button -->
                <a href="{{ article.data.link }}" target="_blank" rel="noopener noreferrer" class="bg-[--accent-color] hover:bg-[#A94A2D] text-white dark:text-gray-900 font-bold py-3 px-6 rounded flex justify-between items-center transition-colors mt-auto">
                    <span>Read the full article ({{ article.data.articleLanguage }})</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </a>
            </article>
            {% endfor %}
        </div>
    </section>
    <!-- Press Kit & Contact Section -->
    <section class="container mx-auto px-6 max-w-6xl mt-20 border-t border-gray-300 dark:border-gray-800 pt-16">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            
            <!-- EXECUTIVE PRESS KIT -->
            <div class="bg-[--card-bg] border border-gray-200 dark:border-gray-800 rounded-xl p-8 shadow-lg flex flex-col justify-center">
                <h3 class="text-xl font-bold text-[--title-color] uppercase tracking-widest mb-8 text-center md:text-left" data-lang-key="mediaPressKitTitle">Executive Press Kit</h3>
                
                <div class="flex flex-col md:flex-row items-center gap-8">
                    <!-- Button -->
                    <div class="w-full md:w-1/2">
                        <a href="/Press_Kit.zip" class="block w-full border-2 border-[--accent-color] text-[--title-color] hover:bg-[--accent-color] hover:text-white dark:hover:text-gray-900 font-bold py-4 px-4 rounded text-center text-sm transition-colors" data-lang-key="mediaPressKitBtn">
                            DOWNLOAD EXECUTIVE PRESS KIT (ZIP)
                        </a>
                    </div>
                    
                   <!-- List -->
                    <div class="w-full md:w-1/2">
                        <ul class="list-disc list-outside ml-4 text-[--text-color] space-y-3 text-sm font-medium">
                            <li data-lang-key="mediaPressKitItem1">Official Press Releases (EN & FR)</li>
                            <li data-lang-key="mediaPressKitItem2">Founder Biography & Headshot</li>
                            <li data-lang-key="mediaPressKitItem3">Technical Rate Cards & Services</li>
                            <li data-lang-key="mediaPressKitItem4">High-Resolution Brand Logos</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- SEAMLESS MEDIA CONTACT -->
            <div class="bg-[--card-bg] border border-gray-200 dark:border-gray-800 rounded-xl p-8 shadow-lg flex flex-col items-center text-center justify-center">
                
                <!-- Title & Sparkle Icon -->
                <div class="flex items-center gap-3 mb-4">
                    <h3 class="text-xl font-bold text-[--title-color] uppercase tracking-widest" data-lang-key="mediaContactTitle">Seamless Media Contact</h3>
                    <svg class="w-8 h-8 text-gray-400 dark:text-gray-500" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z" />
                    </svg>
                </div>
                
                <!-- Subtitle -->
                <p class="text-[--text-color] text-xs md:text-sm uppercase tracking-wider mb-8 font-bold max-w-md" data-lang-key="mediaContactSub">
                    For press inquiries, expert commentary on the Athens market, or investor relations, contact us directly.
                </p>
                
                <!-- Contact Links -->
                <div class="flex flex-col md:flex-row items-center gap-6 mb-8">
                    <!-- Email -->
                    <a href="mailto:press@klehomerie.com" class="flex items-center gap-2 text-[--accent-color] hover:underline font-bold text-lg border-b border-transparent hover:border-[--accent-color] transition-all pb-1">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        press@klehomerie.com
                    </a>
                    
                    <!-- Phone -->
                    <a href="tel:+306940206368" class="flex items-center gap-2 text-[--title-color] hover:text-[--accent-color] transition-colors font-bold text-lg">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                        +30 694 020 6368
                    </a>
                </div>
                
                <!-- Note -->
                <p class="text-xs text-gray-500 dark:text-gray-400" data-lang-key="mediaContactNote">
                    We typically respond to international inquiries within 12 hours across all time zones.
                </p>
            </div>

        </div>
    </section>
</main>