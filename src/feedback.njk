        surveyOpt3Text: "Ναι, αλλά κρατήστε το εντελώς ανώνυμο (π.χ. 'Επενδυτής Ακινήτων, Λονδίνο').",
        surveyOpt4Text: "Όχι, παρακαλώ κρατήστε αυτές τις πληροφορίες απολύτως εμπιστευτικές.",
        surveyBtnSubmitText: "Υποβολή Δεδομένων Αξιολόγησης",
        surveySuccessTitleText: "Η Μεταφορά Δεδομένων Ολοκληρώθηκε",
        surveySuccessDescText: "Οι πληροφορίες του έργου σας έχουν διαβιβαστεί με ασφάλεια στο εσωτερικό μας υπολογιστικό φύλλο. Εκτιμούμε την αντικειμενική σας αξιολόγηση.",
        surveyVoucherTagText: "ΕΠΙΒΕΒΑΙΩΣΗ ΕΙΣΙΤΗΡΙΟΥ P-008",
        surveyVoucherTitleText: "Το Μεταβιβάσιμο Golden Ticket Voucher 30%",
        surveyVoucherDescText: "Το σύστημά μας θα δημιουργήσει και θα σας αποστείλει μέσω email τον μοναδικό, πλήρως μεταβιβάσιμο κωδικό έκπτωσης 30% για την Ενδελεχή Τεχνική Επιθεώρηση P-008 εντός των επόμενων 24 ωρών. Μπορείτε να τον χρησιμοποιήσετε για δικές σας μελλοντικές αγορές ή να τον μεταβιβάσετε απευθείας σε άλλον επενδυτή που δραστηριοποιείται στην Αττική."
    });

    // 2. FORCE INITIAL ENGINE COUPLING
    const urlParams = new URLSearchParams(window.location.search);
    const activeLang = urlParams.get('lang') || localStorage.getItem('lang') || 'en';
    if (typeof updateLanguage === 'function') {
        updateLanguage(activeLang);
    }
// Capture invisible parameters from the URL address bar
    const urlClientName = urlParams.get('name');
    const urlQuoteId = urlParams.get('quote');

    if (urlClientName) {
        document.getElementById('kh-client-name').value = urlClientName.replace(/_/g, ' ');
    }
    if (urlQuoteId) {
        document.getElementById('kh-quote-id').value = urlQuoteId.toUpperCase();
    }
    // 3. STEP MACHINE HANDSHAKES
    const welcomeView = document.getElementById('kh-welcome-view');
    const surveyForm = document.getElementById('kh-survey-form');
    const successView = document.getElementById('kh-success-view');
    const startBtn = document.getElementById('kh-start-survey-btn');
    const STORAGE_KEY = 'kh_feedback_draft_v4';

    if(startBtn) {
        startBtn.addEventListener('click', function() {
            welcomeView.classList.add('hidden');
            surveyForm.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    }

    // 4. NETLIFY FORM TRANSMISSION INTERCEPT
    if(surveyForm) {
        surveyForm.addEventListener('submit', function (e) {
            e.preventDefault();
            const formData = new FormData(surveyForm);
            const submitBtn = surveyForm.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Transmitting...';

            fetch('/', {
                method: 'POST',
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: new URLSearchParams(formData).toString()
            })
            .then(response => {
                if (response.ok) {
                    localStorage.removeItem(STORAGE_KEY);
                    surveyForm.classList.add('hidden');
                    successView.classList.remove('hidden');
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                } else {
                    alert("Transmission error. Please try again.");
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Submit Evaluation Data';
                }
            })
            .catch(error => {
                alert("Network connection error.");
                submitBtn.disabled = false;
                submitBtn.textContent = 'Submit Evaluation Data';
            });
        });

     // 5. CACHE REHYDRATION MECHANISM WITH HIDDEN FIELD RETENTION
        function saveDraft() {
            const data = {};
            // Include both standard textareas and hidden crm input nodes
            surveyForm.querySelectorAll('textarea, input[type="hidden"]').forEach(el => {
                if (el.name !== 'form-name') data[el.name] = el.value;
            });
            const activeRating = surveyForm.querySelector('input[name="service_rating"]:checked');
            if (activeRating) data['service_rating'] = activeRating.value;

            const activeConsent = surveyForm.querySelector('input[name="public_consent"]:checked');
            if (activeConsent) data['public_consent'] = activeConsent.value;

            localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
        }

        function loadDraft() {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (!raw) return;
            try {
                const data = JSON.parse(raw);
                Object.keys(data).forEach(key => {
                    const el = surveyForm.querySelector(`[name="${key}"]`);
                    if (el) {
                        if (el.type === 'textarea' || el.type === 'hidden') {
                            el.value = data[key];
                        } else {
                            const radioTarget = surveyForm.querySelector(`input[name="${key}"][value="${data[key]}"]`);
                            if (radioTarget) radioTarget.checked = true;
                        }
                    }
                });
                
                // Absolute priority rule: If fresh params are explicitly passed in URL, overwrite cache parameters
                if (urlClientName) document.getElementById('kh-client-name').value = urlClientName.replace(/_/g, ' ');
                if (urlQuoteId) document.getElementById('kh-quote-id').value = urlQuoteId.toUpperCase();
            } catch (e) {
                console.error(e);
            }
        }

        surveyForm.addEventListener('input', saveDraft);
        surveyForm.querySelectorAll('input[type="radio"]').forEach(radio => {
            radio.addEventListener('change', saveDraft);
        });

        loadDraft();
    }
});
</script>