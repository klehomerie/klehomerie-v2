            <button type="submit" class="kh-submit-btn">
                <span>Submit Feedback</span>
            </button>
        </form>

    </div>
</div>

<script>
// Small interactive script to handle star visual selections cleanly
document.addEventListener('DOMContentLoaded', () => {
    const stars = document.querySelectorAll('.kh-rating-stars label');
    const inputs = document.querySelectorAll('.kh-rating-stars input');
    
    stars.forEach((star, index) => {
        // Reverse indexing because array order matches layout
        const realIndex = 4 - index;
        
        star.addEventListener('click', () => {
            inputs[realIndex].checked = true;
            // Update color arrays instantly
            stars.forEach((s, idx) => {
                if (idx >= index) {
                    s.style.color = 'var(--kh-star-active)';
                } else {
                    s.style.color = 'var(--kh-star-color)';
                }
            });
        });
    });
});
</script>