/* ==========================================================================
   6. STATE ENGAGEMENT & RECOVERY SYSTEM SCRIPTS
   ========================================================================== */
<script>
document.addEventListener('DOMContentLoaded', function () {
    const welcomeView = document.getElementById('kh-welcome-view');
    const surveyForm = document.getElementById('kh-survey-form');
    const successView = document.getElementById('kh-success-view');
    const startBtn = document.getElementById('kh-start-survey-btn');

    const STORAGE_KEY = 'kh_feedback_draft';

    // 1. STEP NAVIGATION TRIGGER
    startBtn.addEventListener('click', function() {
        welcomeView.classList.add('hidden');
        surveyForm.classList.remove('hidden');
        window.scrollTo({ top: surveyForm.offsetTop - 100, behavior: 'smooth' });
    });

    // 2. BACKEND TRANSMISSION INTERCEPTOR
    surveyForm.addEventListener('submit', function (e) {
        e.preventDefault();
        const formData = new FormData(surveyForm);
        const submitBtn = surveyForm.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Transmitting...';

        // Direct async delivery to Netlify Forms engine
        fetch('/', {
            method: 'POST',
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: new URLSearchParams(formData).toString()
        })
        .then(response => {
            if (response.ok) {
                // Wipe cache memory on successful transaction
                localStorage.removeItem(STORAGE_KEY);
                surveyForm.classList.add('hidden');
                successView.classList.remove('hidden');
                window.scrollTo({ top: successView.offsetTop - 120, behavior: 'smooth' });
            } else {
                alert("Transmission error. Please try again.");
                submitBtn.disabled = false;
                submitBtn.textContent = 'Submit Feedback';
            }
        })
        .catch(error => {
            alert("Network connection error. Please verify link.");
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit Feedback';
        });
    });

    // 3. PERSISTENT AUTOSAVE CACHE OPERATIONS
    function saveDraft() {
        const data = {};
        // Scrape textarea text assets
        surveyForm.querySelectorAll('textarea').forEach(el => {
            data[el.name] = el.value;
        });
        // Scrape active metric checks
        const activeRating = surveyForm.querySelector('input[name="service_rating"]:checked');
        if (activeRating) data['service_rating'] = activeRating.value;

        const activeConsent = surveyForm.querySelector('input[name="public_consent"]:checked');
        if (activeConsent) data['public_consent'] = activeConsent.value;

        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    }

    function loadDraft() {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        try {
            const data = JSON.parse(raw);
            
            // Rehydrate string inputs
            Object.keys(data).forEach(key => {
                const el = surveyForm.querySelector(`[name="${key}"]`);
                if (el) {
                    if (el.type === 'textarea') {
                        el.value = data[key];
                    } else {
                        // Rehydrate checked inputs (radios)
                        const radioTarget = surveyForm.querySelector(`input[name="${key}"][value="${data[key]}"]`);
                        if (radioTarget) radioTarget.checked = true;
                    }
                }
            });
        } catch (e) {
            console.error("Draft parsing recovery aborted.", e);
        }
    }

    // Bind real-time tracker observers
    surveyForm.addEventListener('input', saveDraft);
    surveyForm.querySelectorAll('input[type="radio"]').forEach(radio => {
        radio.addEventListener('change', saveDraft);
    });

    // Execute instant memory assembly on lifecycle start
    loadDraft();
});
</script>