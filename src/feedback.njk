<style>
/* ==========================================================================
   KLEHOMERIE FEEDBACK ENGINE VARIABLES & LIGHT/DARK SYSTEM
   ========================================================================== */
:root {
  --kh-font-title: 'Poppins', -apple-system, sans-serif;
  --kh-font-body: 'Lato', -apple-system, sans-serif;

  --kh-bg: #f8fafc;
  --kh-card-bg: #ffffff;
  --kh-accent: #C66C54;
  --kh-accent-hover: #A94A2D;
  --kh-title: #1c1a3c;
  --kh-text: #475569;
  --kh-hint: #64748b;
  --kh-input-bg: #ffffff;
  --kh-border: #e2e8f0;
  --kh-focus-ring: rgba(198, 108, 84, 0.15);
  --kh-shadow: 0 10px 25px -5px rgba(28, 26, 60, 0.05);
  --kh-star-color: #cbd5e1;
  --kh-star-active: #f59e0b;
}

body.dark-theme, body.dark {
  --kh-bg: #0f172a;
  --kh-card-bg: #1e293b;
  --kh-title: #f8fafc;
  --kh-text: #94a3b8;
  --kh-hint: #64748b;
  --kh-input-bg: #0f172a;
  --kh-border: #334155;
  --kh-focus-ring: rgba(198, 108, 84, 0.3);
  --kh-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
  --kh-star-color: #475569;
}

.kh-feedback-wrapper { font-family: var(--kh-font-body); background-color: var(--kh-bg); min-height: 100vh; padding: 60px 20px; display: flex; justify-content: center; align-items: center; transition: background-color 0.2s; }
.kh-feedback-card { background-color: var(--kh-card-bg); max-width: 720px; width: 100%; padding: 45px; border-radius: 16px; border: 1px solid var(--kh-border); box-shadow: var(--kh-shadow); transition: background-color 0.2s, border-color 0.2s; }
.kh-feedback-header { border-bottom: 2px solid var(--kh-border); padding-bottom: 25px; margin-bottom: 35px; text-align: left; }
.kh-feedback-header h1 { font-family: var(--kh-font-title); color: var(--kh-title); font-size: 2rem; font-weight: 700; margin: 0 0 10px 0; }
.kh-feedback-header p { color: var(--kh-text); font-size: 1rem; margin: 0; }

.kh-form-group { margin-bottom: 32px; display: flex; flex-direction: column; }
.kh-form-label { font-family: var(--kh-font-title); color: var(--kh-title); font-size: 1rem; font-weight: 700; line-height: 1.4; margin-bottom: 8px; }
.kh-form-control { font-family: var(--kh-font-body); background-color: var(--kh-input-bg); color: var(--kh-title); border: 1px solid var(--kh-border); border-radius: 8px; padding: 14px 18px; font-size: 1rem; outline: none; resize: vertical; min-height: 110px; transition: border-color 0.2s, box-shadow 0.2s; }
.kh-form-control:focus { border-color: var(--kh-accent); box-shadow: 0 0 0 4px var(--kh-focus-ring); }

/* Custom 5-Star Rating CSS Architecture (Reversed for pure CSS hover effects) */
.kh-rating-stars { display: inline-flex; flex-direction: row-reverse; justify-content: flex-end; gap: 8px; margin-top: 4px; }
.kh-rating-stars input { display: none; }
.kh-rating-stars label { font-size: 2.25rem; color: var(--kh-star-color); cursor: pointer; transition: color 0.15s ease; }
.kh-rating-stars input:checked ~ label,
.kh-rating-stars label:hover,
.kh-rating-stars label:hover ~ label { color: var(--kh-star-active); }

.kh-radio-stack { display: flex; flex-direction: column; gap: 12px; margin-top: 6px; }
.kh-radio-label { display: flex; align-items: flex-start; gap: 12px; background-color: var(--kh-input-bg); border: 1px solid var(--kh-border); padding: 14px 18px; border-radius: 8px; cursor: pointer; font-size: 0.95rem; color: var(--kh-text); transition: border-color 0.2s; }
.kh-radio-input { appearance: none; -webkit-appearance: none; background-color: var(--kh-input-bg); margin: 4px 0 0 0; width: 16px; height: 16px; border: 2px solid var(--kh-border); border-radius: 50%; display: grid; place-content: center; flex-shrink: 0; cursor: pointer; }
.kh-radio-input::before { content: ""; width: 8px; height: 8px; border-radius: 50%; transform: scale(0); transition: 0.15s transform; background-color: var(--kh-accent); }
.kh-radio-input:checked { border-color: var(--kh-accent); }
.kh-radio-input:checked::before { transform: scale(1); }
.kh-radio-label:has(.kh-radio-input:checked) { border-color: var(--kh-accent); color: var(--kh-title); }

.kh-submit-btn { font-family: var(--kh-font-title); background-color: var(--kh-accent); color: #ffffff; font-size: 1rem; font-weight: 700; width: 100%; padding: 16px; border: none; border-radius: 8px; cursor: pointer; margin-top: 15px; display: flex; align-items: center; justify-content: center; gap: 10px; transition: background-color 0.2s; }
body.dark-theme .kh-submit-btn, body.dark .kh-submit-btn { color: #0f172a; }
.kh-submit-btn:hover { background-color: var(--kh-accent-hover); }

@media (max-width: 768px) { .kh-feedback-card { padding: 25px; } }
</style>

<div class="kh-feedback-wrapper">
    <div class="kh-feedback-card">
        
        <div class="kh-feedback-header">
