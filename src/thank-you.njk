<script>
(function() {
    var params = new URLSearchParams(window.location.search);
    var pageSource = params.get('source') || 'homepage';

    if (typeof gtag === 'function') {
        gtag('event', 'contact_request', {
            'page_source': pageSource
        });
    }

    if (typeof fbq === 'function') {
        fbq('track', 'Lead');
    }
})();
</script>
