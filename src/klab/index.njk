---
layout: base.njk
title: Klehomerie Lab - Technical Insights
---

<header class="relative pt-32 pb-20 px-6 text-center overflow-hidden transition-colors duration-300" 
        style="background-color: var(--bg-color); color: var(--title-color);">
    <div class="absolute inset-0 opacity-10 bg-[url('/assets/images/hero-marble.png')] bg-cover bg-center mix-blend-overlay"></div>
    <div class="relative z-10 max-w-3xl mx-auto">
        <div class="inline-block p-4 rounded-full bg-[--accent-color] bg-opacity-10 mb-8 shadow-sm">
            <span class="text-4xl">🔬</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold mb-4 font-['Poppins'] tracking-tight" style="color: var(--title-color);">
            Klehomerie Insights Lab
        </h1>
        <p class="text-lg leading-relaxed max-w-2xl mx-auto font-['Lato'] opacity-90" style="color: var(--text-color);">
            Case studies, thermal forensics, and technical reality checks for the Athens real estate market.
        </p>
    </div>
</header>

<div class="sticky top-0 z-30 bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-md border-b border-gray-200 dark:border-gray-700 shadow-sm transition-colors duration-300">
    <div class="container mx-auto px-4 py-4">
        <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
            
            <div class="relative w-full md:w-1/3">
                <span class="absolute left-3 top-2.5 text-gray-400">🔍</span>
                <input type="text" id="searchInput" placeholder="Search articles..." 
                       class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-slate-800 text-sm focus:ring-2 focus:ring-[--accent-color] outline-none">
            </div>

            <div class="flex flex-wrap gap-2 w-full md:w-auto justify-end">
                
                <select id="categorySelect" class="bg-gray-50 dark:bg-slate-800 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 text-sm rounded-lg focus:ring-[--accent-color] focus:border-[--accent-color] block p-2">
                    <option value="all">📂 All Categories</option>
                    <option value="Red Flag Scans">🚩 Red Flag Scans</option>
                    <option value="Golden Visa Strategy">💳 Golden Visa</option>
                    <option value="French Standards">🇫🇷 Standards</option>
                    <option value="Technical Insights">💡 Insights</option>
                    <option value="Regulatory Vigie">⚖️ Regulatory</option>
                </select>

                <select id="languageSelect" class="bg-gray-50 dark:bg-slate-800 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 text-sm rounded-lg focus:ring-[--accent-color] focus:border-[--accent-color] block p-2">
                    <option value="all">🌐 All Languages</option>
                    <option value="en">🇬🇧 English</option>
                    <option value="fr">🇫🇷 Français</option>
                </select>

                <select id="sortSelect" class="bg-gray-50 dark:bg-slate-800 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 text-sm rounded-lg focus:ring-[--accent-color] focus:border-[--accent-color] block p-2">
                    <option value="newest">📅 Newest First</option>
                    <option value="oldest">📅 Oldest First</option>
                    <option value="favorites">❤️ My Favorites</option>
                </select>

            </div>
        </div>
    </div>
</div>

<section class="container mx-auto px-6 py-16 min-h-[50vh]">
    <div id="postsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        {% for post in collections.post | reverse %}
        <article class="card rounded-xl overflow-hidden flex flex-col h-full shadow-lg transition-transform duration-300 hover:-translate-y-1 relative group"
                 data-category="{{ post.data.category }}"
                 data-language="{{ post.data.language or 'en' }}"
                 data-date="{{ post.date }}"
                 data-id="{{ post.url }}"> <a href="{{ post.url }}" class="block h-48 overflow-hidden relative">
                <img src="{{ post.data.image or '/assets/images/hero-athens-view.webp' }}" 
                     alt="{{ post.data.title }}" 
                     class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                
                <div class="absolute top-4 left-4 text-white text-xs font-bold px-2 py-1 rounded shadow-sm z-10" style="background-color: var(--accent-color);">
                    {{ post.data.category or "Insight" }}
                </div>
            </a>

            <button class="like-btn absolute top-4 right-14 bg-white/90 backdrop-blur-sm p-1.5 rounded-full shadow-sm z-20 hover:scale-110 transition-transform cursor-pointer border border-gray-100 group/btn"
                    onclick="toggleLike(this, '{{ post.url }}')"
                    title="Save to Favorites">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 group-hover/btn:text-red-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
            </button>

            <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-2 py-1 rounded-full shadow-sm text-lg leading-none select-none z-20 pointer-events-none">
                {% if post.data.language == 'fr' %}🇫🇷{% else %}🇬🇧{% endif %}
            </div>

            <div class="p-6 flex-1 flex flex-col">
                <div class="text-xs text-gray-400 mb-2 font-mono">
                    {{ post.date | dateString }} • {{ post.data.property_type or "General" }}
                </div>
                
                <h3 class="text-xl font-bold mb-3 leading-tight font-['Poppins']">
                    <a href="{{ post.url }}" class="hover:text-[--accent-color] transition-colors" style="color: var(--title-color);">
                        {{ post.data.title }}
                    </a>
                </h3>
                
                <p class="text-sm mb-4 line-clamp-3 flex-1 font-['Lato']" style="color: var(--text-color);">
                    {{ post.data.summary }}
                </p>
                
                <a href="{{ post.url }}" class="font-bold text-sm hover:underline mt-auto flex items-center gap-1" style="color: var(--accent-color);">
                    Read Audit <span class="text-lg">→</span>
                </a>
            </div>
        </article>
        {% endfor %}

    </div>
    
    <div id="noResults" class="hidden text-center py-20">
        <div class="text-6xl mb-4">🕵️‍♂️</div>
        <h3 class="text-xl font-bold text-gray-500">No audits found.</h3>
        <p class="text-gray-400">Try adjusting your filters.</p>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('searchInput');
        const categorySelect = document.getElementById('categorySelect');
        const languageSelect = document.getElementById('languageSelect');
        const sortSelect = document.getElementById('sortSelect');
        const postsGrid = document.getElementById('postsGrid');
        const cards = Array.from(document.querySelectorAll('article.card'));
        const noResults = document.getElementById('noResults');

        // --- 1. MEMORY SYSTEM (Session Storage) ---
        // This restores the user's previous view when they come back from an article
        function loadState() {
            const savedState = JSON.parse(sessionStorage.getItem('klab_state'));
            if (savedState) {
                if (savedState.search) searchInput.value = savedState.search;
                if (savedState.category) categorySelect.value = savedState.category;
                if (savedState.language) languageSelect.value = savedState.language;
                if (savedState.sort) sortSelect.value = savedState.sort;
            }
        }

        function saveState() {
            const state = {
                search: searchInput.value,
                category: categorySelect.value,
                language: languageSelect.value,
                sort: sortSelect.value
            };
            sessionStorage.setItem('klab_state', JSON.stringify(state));
        }
        // ------------------------------------------

        // 2. INITIALIZE LIKES (Local Storage - Persists forever)
        const favorites = JSON.parse(localStorage.getItem('klehomerie_favorites')) || [];
        
        cards.forEach(card => {
            const id = card.dataset.id;
            if (favorites.includes(id)) {
                setHeartActive(card.querySelector('.like-btn'), true);
            }
        });

        // 3. MAIN FILTER FUNCTION
        function filterContent() {
            // Save state every time we filter
            saveState();

            const query = searchInput.value.toLowerCase();
            const category = categorySelect.value;
            const language = languageSelect.value;
            const sortMode = sortSelect.value;
            
            let visibleCount = 0;

            // A. Filter Visibility
            cards.forEach(card => {
                const title = card.querySelector('h3').innerText.toLowerCase();
                const summary = card.querySelector('p').innerText.toLowerCase();
                const cardCat = card.dataset.category || "";
                const cardLang = card.dataset.language || "en";
                const cardId = card.dataset.id;

                const matchesSearch = title.includes(query) || summary.includes(query);
                const matchesCategory = category === 'all' || cardCat.includes(category);
                const matchesLanguage = language === 'all' || cardLang === language;
                const matchesFavorites = sortMode !== 'favorites' || favorites.includes(cardId);

                if (matchesSearch && matchesCategory && matchesLanguage && matchesFavorites) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // B. Sort Logic
            if (sortMode === 'newest' || sortMode === 'oldest') {
                const sortedCards = cards.sort((a, b) => {
                    const dateA = new Date(a.dataset.date);
                    const dateB = new Date(b.dataset.date);
                    return sortMode === 'newest' ? dateB - dateA : dateA - dateB;
                });
                sortedCards.forEach(card => postsGrid.appendChild(card));
            }

            // C. Show/Hide Empty State
            noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        // 4. EVENT LISTENERS
        searchInput.addEventListener('input', filterContent);
        categorySelect.addEventListener('change', filterContent);
        languageSelect.addEventListener('change', filterContent);
        sortSelect.addEventListener('change', filterContent);

        // 5. LIKE FUNCTION
        window.toggleLike = function(btn, id) {
            event.preventDefault(); 
            event.stopPropagation();
            
            const index = favorites.indexOf(id);
            const isLiked = index !== -1;

            if (isLiked) {
                favorites.splice(index, 1);
                setHeartActive(btn, false);
            } else {
                favorites.push(id);
                setHeartActive(btn, true);
                
                // Google Tracking
                if (typeof gtag === 'function') {
                    gtag('event', 'like_article', {
                        'event_category': 'Engagement',
                        'event_label': id,
                        'value': 1
                    });
                }
            }

            localStorage.setItem('klehomerie_favorites', JSON.stringify(favorites));
            if (sortSelect.value === 'favorites') filterContent();
        };

        function setHeartActive(btn, isActive) {
            const svg = btn.querySelector('svg');
            if (isActive) {
                svg.classList.remove('text-gray-400');
                svg.classList.add('text-red-500', 'fill-current');
            } else {
                svg.classList.add('text-gray-400');
                svg.classList.remove('text-red-500', 'fill-current');
            }
        }

        // --- EXECUTE ON LOAD ---
        loadState();      // 1. Restore previous filters
        filterContent();  // 2. Apply them immediately
    });
</script>