---
layout: base.njk
title: Klehomerie - Client & Partner Testimonials
image: /assets/images/hero-athens-view.webp
---

<header class="relative pt-32 pb-20 flex items-center justify-center text-center overflow-hidden z-10">
    <picture class="absolute inset-0 w-full h-full z-0">
        <source media="(max-width: 768px)" srcset="/assets/images/hero-athens-view-mobile.webp" type="image/webp">
        <source srcset="/assets/images/hero-athens-view.webp" type="image/webp">
        <img src="/assets/images/hero-athens-view.webp" 
             alt="Klehomerie Technical Asset Management - Client & Partner Testimonials Background" 
             class="hero-img object-cover w-full h-full block filter blur-[2px] scale-105" 
             fetchpriority="high" 
             loading="eager">
    </picture>
    
    <div class="hero-overlay absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-[--bg-color] z-10"></div>
    
    <div class="relative z-20 px-6 max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 drop-shadow-lg tracking-tight" data-lang-key="testiPageTitle">Trust Built on Concrete</h1>
        <p class="text-lg md:text-xl text-gray-200 font-light max-w-2xl mx-auto drop-shadow-md" data-lang-key="testiPageSub">Read the full stories from our international investors and local partners.</p>
    </div>
</header>

<main class="pb-20 bg-[--bg-color]">
    <div class="container mx-auto px-6 max-w-4xl">
        
        <div class="flex justify-center gap-4 mb-12 -mt-6 relative z-20">
            <button id="btn-clients" onclick="switchTab('clients')" class="px-6 py-2 rounded-full font-bold bg-[--accent-color] text-white shadow-md transition-colors">
                Client Stories
            </button>
            <button id="btn-partners" onclick="switchTab('partners')" class="px-6 py-2 rounded-full font-bold bg-gray-200 text-gray-600 dark:bg-gray-800 dark:text-gray-300 shadow-md transition-colors">
                Partner Insights
            </button>
        </div>

        <div id="tab-clients" class="space-y-8 animate-fade-in">
            {% for item in testimonials.items %}
                {% if item.type == 'client' %}
                <div class="bg-[--card-bg] p-8 rounded-xl shadow-md border-l-4 border-[--accent-color]">
                    
                    <div class="lang-en testimonial-render-block">
                        <p class="text-lg text-[--text-color] mb-4 whitespace-pre-line italic">
                            &ldquo;{{ item.fullQuote_en | default(item.fullQuoteOriginal) }}&rdquo;
                        </p>
                        {% if item.originalLanguage and item.originalLanguage != 'en' %}
                            <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mt-2 mb-6">
                                (Original language: {% if item.originalLanguage == 'fr' %}French{% elif item.originalLanguage == 'el' %}Greek{% endif %})
                            </p>
                        {% else %}
                            <div class="mb-6"></div>
                        {% endif %}
                    </div>

                    <div class="lang-fr hidden testimonial-render-block">
                        <p class="text-lg text-[--text-color] mb-4 whitespace-pre-line italic">
                            &ldquo;{{ item.fullQuote_fr | default(item.fullQuoteOriginal) }}&rdquo;
                        </p>
                        {% if item.originalLanguage and item.originalLanguage != 'fr' %}
                            <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mt-2 mb-6">
                                (Langue d'origine : {% if item.originalLanguage == 'en' %}Anglais{% elif item.originalLanguage == 'el' %}Grec{% endif %})
                            </p>
                        {% else %}
                            <div class="mb-6"></div>
                        {% endif %}
                    </div>

                    <div class="lang-el hidden testimonial-render-block">
                        <p class="text-lg text-[--text-color] mb-4 whitespace-pre-line italic">
                            &ldquo;{{ item.fullQuote_el | default(item.fullQuoteOriginal) }}&rdquo;
                        </p>
                        {% if item.originalLanguage and item.originalLanguage != 'el' %}
                            <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mt-2 mb-6">
                                (Αρχική γλώσσα: {% if item.originalLanguage == 'en' %}Αγγλικά{% elif item.originalLanguage == 'fr' %}Γαλλικά{% endif %})
                            </p>
                        {% else %}
                            <div class="mb-6"></div>
                        {% endif %}
                    </div>
                    
                    <div class="flex items-center gap-4 border-t border-gray-100 dark:border-gray-700 pt-6">
                        {% if item.image %}
                            <img src="{{ item.image }}" alt="{{ item.name }}" class="h-12 w-12 rounded-full object-cover">
                        {% else %}
                            <div class="h-12 w-12 bg-[--accent-color] rounded-full flex items-center justify-center text-white font-bold">
                                {{ item.name | truncate(2, true, "") }}
                            </div>
                        {% endif %}
                        <div>
                            <div class="font-bold text-[--title-color]">{{ item.name }}</div>
                            <div class="text-sm text-gray-500">
                                {% if item.website %}
                                    <a href="{{ item.website }}" target="_blank" rel="noopener noreferrer" class="hover:text-[--accent-color] hover:underline transition-colors">
                                        {{ item.role }}
                                    </a>
                                {% else %}
                                    {{ item.role }}
                                {% endif %}
                                {% if item.location %} • {{ item.location }}{% endif %}
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>

        <div id="tab-partners" class="space-y-8 hidden animate-fade-in">
            {% for item in testimonials.items %}
                {% if item.type != 'client' %}
                <div class="bg-[--secondary-bg] p-8 rounded-xl border border-gray-200 dark:border-gray-700">
                    
                    <div class="lang-en testimonial-render-block">
                        <p class="text-lg text-[--text-color] mb-4 whitespace-pre-line italic">
                            &ldquo;{{ item.fullQuote_en | default(item.fullQuoteOriginal) }}&rdquo;
                        </p>
                        {% if item.originalLanguage and item.originalLanguage != 'en' %}
                            <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mt-2 mb-6">
                                (Original language: {% if item.originalLanguage == 'fr' %}French{% elif item.originalLanguage == 'el' %}Greek{% endif %})
                            </p>
                        {% else %}
                            <div class="mb-6"></div>
                        {% endif %}
                    </div>

                    <div class="lang-fr hidden testimonial-render-block">
                        <p class="text-lg text-[--text-color] mb-4 whitespace-pre-line italic">
                            &ldquo;{{ item.fullQuote_fr | default(item.fullQuoteOriginal) }}&rdquo;
                        </p>
                        {% if item.originalLanguage and item.originalLanguage != 'fr' %}
                            <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mt-2 mb-6">
                                (Langue d'origine : {% if item.originalLanguage == 'en' %}Anglais{% elif item.originalLanguage == 'el' %}Grec{% endif %})
                            </p>
                        {% else %}
                            <div class="mb-6"></div>
                        {% endif %}
                    </div>

                    <div class="lang-el hidden testimonial-render-block">
                        <p class="text-lg text-[--text-color] mb-4 whitespace-pre-line italic">
                            &ldquo;{{ item.fullQuote_el | default(item.fullQuoteOriginal) }}&rdquo;
                        </p>
                        {% if item.originalLanguage and item.originalLanguage != 'el' %}
                            <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mt-2 mb-6">
                                (Αρχική γλώσσα: {% if item.originalLanguage == 'en' %}Αγγλικά{% elif item.originalLanguage == 'fr' %}Γαλλικά{% endif %})
                            </p>
                        {% else %}
                            <div class="mb-6"></div>
                        {% endif %}
                    </div>

                    <div class="flex items-center gap-4 border-t border-gray-200 dark:border-gray-600 pt-6">
                        {% if item.image %}
                            <img src="{{ item.image }}" alt="{{ item.name }}" class="h-12 w-12 rounded-full object-cover">
                        {% else %}
                            <div class="h-12 w-12 bg-gray-400 rounded-full flex items-center justify-center text-white font-bold">
                                {{ item.name | truncate(2, true, "") }}
                            </div>
                        {% endif %}
                        <div>
                            <div class="font-bold text-[--title-color]">{{ item.name }}</div>
                            <div class="text-sm text-gray-500">
                                {% if item.website %}
                                    <a href="{{ item.website }}" target="_blank" rel="noopener noreferrer" class="hover:text-[--accent-color] hover:underline transition-colors">
                                        {{ item.role }}
                                    </a>
                                {% else %}
                                    {{ item.role }}
                                {% endif %}
                                {% if item.location %} • {{ item.location }}{% endif %}
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>

    </div>
</main>

<style>
  /* Isolated Multi-Language Display Logic Bounds */
  .testimonial-render-block { display: none; }
  
  html[lang="en"] .testimonial-render-block.lang-en,
  :root:not([lang]) .testimonial-render-block.lang-en,
  html:not([lang]) .testimonial-render-block.lang-en { display: block !important; }
  
  html[lang="fr"] .testimonial-render-block.lang-fr { display: block !important; }
  html[lang="el"] .testimonial-render-block.lang-el { display: block !important; }
  
  html[lang="fr"] .testimonial-render-block.lang-en { display: none !important; }
  html[lang="el"] .testimonial-render-block.lang-en { display: none !important; }
</style>

<script>
// --- TAB SWITCHING INTERACTION ENGINE ---
function switchTab(tab) {
    const tabClients = document.getElementById('tab-clients');
    const tabPartners = document.getElementById('tab-partners');
    const btnClients = document.getElementById('btn-clients');
    const btnPartners = document.getElementById('btn-partners');

    const activeClasses = ['bg-[--accent-color]', 'text-white'];
    const inactiveClasses = ['bg-gray-200', 'text-gray-600', 'dark:bg-gray-800', 'dark:text-gray-300'];

    if (tab === 'clients') {
        tabClients.classList.remove('hidden');
        tabPartners.classList.add('hidden');
        
        btnClients.classList.remove(...inactiveClasses);
        btnClients.classList.add(...activeClasses);
        
        btnPartners.classList.remove(...activeClasses);
        btnPartners.classList.add(...inactiveClasses);
    } else {
        tabPartners.classList.remove('hidden');
        tabClients.classList.add('hidden');
        
        btnPartners.classList.remove(...inactiveClasses);
        btnPartners.classList.add(...activeClasses);
        
        btnClients.classList.remove(...activeClasses);
        btnClients.classList.add(...inactiveClasses);
    }
}

// --- GLOBAL NAVIGATION SYNC COUPLER ---
document.addEventListener('click', function(e) {
    const langBtn = e.target.closest('.lang-btn');
    if (langBtn) {
        const targetLang = langBtn.getAttribute('data-lang'); 
        
        document.querySelectorAll('.testimonial-render-block').forEach(quote => {
            quote.style.setProperty('display', 'none', 'important');
        });

        const activeClass = targetLang === 'en' ? '.lang-en' : (targetLang === 'fr' ? '.lang-fr' : '.lang-el');
        document.querySelectorAll('.testimonial-render-block' + activeClass).forEach(quote => {
            quote.style.setProperty('display', 'block', 'important');
        });
    }
});
</script>